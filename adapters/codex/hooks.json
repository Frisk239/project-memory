{
  "description": "Reference snapshot of the Codex hooks install writes into ~/.codex/hooks.json. install (dist/cli.js) builds this programmatically with absolute paths and does NOT read this file — edit the install code, not this copy.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node dist/cli.js hook --flavor codex",
            "commandWindows": "node dist/cli.js hook --flavor codex",
            "statusMessage": "Loading project memory",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node dist/cli.js hook --flavor codex",
            "commandWindows": "node dist/cli.js hook --flavor codex",
            "statusMessage": "Project memory write reminder",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
