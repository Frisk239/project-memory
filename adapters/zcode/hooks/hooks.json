{
  "description": "Reference snapshot of the ZCode plugin-form hooks. install (dist/cli.js) writes user-level hooks into ~/.zcode/cli/config.json directly and does NOT read this file.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/run.mjs"],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/run.mjs"],
            "timeoutMs": 4000
          }
        ]
      }
    ]
  }
}
